  <step>
    <name>classificacao_orcamentaria</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>baseModelagem_gp5</connection>
    <sql>SELECT DISTINCT
    f.codigo_funcao, f.nome_funcao,
    p.codigo_programa, p.nome_programa,
    a.codigo_acao, a.nome_acao,
    ce.codigo_categoria_economica, ce.nome_categoria_economica,
    nd.codigo_natureza, nd.nome_natureza_despesa,
    ma.codigo_modalidade_aplicacao, ma.nome_modalidade_aplicacao,
    ed.codigo_elemento_despesa, ed.nome_elemento_despesa,
    fr.codigo_fonte_recurso, fr.nome_fonte_recurso
FROM despesa d
INNER JOIN funcao f ON d.codigo_funcao = f.codigo_funcao
INNER JOIN programa p ON d.codigo_programa = p.codigo_programa
INNER JOIN acao a ON d.codigo_acao = a.codigo_acao
INNER JOIN categoria_economica ce ON d.codigo_categoria_economica = ce.codigo_categoria_economica
INNER JOIN natureza_despesa nd ON d.codigo_natureza = nd.codigo_natureza
INNER JOIN modalidade_aplicacao ma ON d.codigo_modalidade_aplicacao = ma.codigo_modalidade_aplicacao
INNER JOIN elemento_despesa ed ON d.codigo_elemento_despesa = ed.codigo_elemento_despesa
INNER JOIN fonte_recurso fr ON d.codigo_fonte_recurso = fr.codigo_fonte_recurso</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
