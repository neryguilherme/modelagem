      <schema_name/>
    </partitioning>
    <connection>baseModelagem_gp5</connection>
    <sql>SELECT
    CAST(d.data_empenho AS DATETIME) AS iddata,
    COALESCE(ug.id_municipio, 0) AS idmunicipio,
    COALESCE(d.codigo_unidade_gestora, 0) AS idug,
    COALESCE(d.cpf_cnpj, '0') AS idcredor,
    COALESCE(d.id_licitacao, 0) AS idlicitacao,
    COALESCE(d.codigo_funcao, 0) AS codigo_funcao,
    COALESCE(d.codigo_programa, 0) AS codigo_programa,
    COALESCE(d.codigo_acao, '0') AS codigo_acao,
    COALESCE(d.codigo_categoria_economica, 0) AS codigo_categoria_economica,
    COALESCE(d.codigo_natureza, 0) AS codigo_natureza,
    COALESCE(d.codigo_modalidade_aplicacao, 0) AS codigo_modalidade_aplicacao,
    COALESCE(d.codigo_elemento_despesa, 0) AS codigo_elemento_despesa,
    COALESCE(d.codigo_fonte_recurso, 0) AS codigo_fonte_recurso,
    COALESCE(d.valor_empenhado, 0.00) AS valorEmpenhado,
    COALESCE(d.valor_liquidado, 0.00) AS valorLiquidado,
    COALESCE(d.valor_pago, 0.00) AS valorPago,
    COALESCE(d.valor_empenhado - d.valor_pago, 0.00) AS saldoAPagar
FROM modelagem.despesa d
LEFT JOIN modelagem.unidade_gestora ug
    ON d.codigo_unidade_gestora = ug.codigo_unidade_gestora;</sql>
    <limit>0</limit>
    <lookup/>
